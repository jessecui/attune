# Name the access prompt asks for (required). Matched ignoring case and spaces.
CREATOR_NAME=

# The GPU service on Modal (not needed with ATTUNE_MOCK=1). scripts/app.sh fills these in locally.
# ATTUNE_MODAL_URL=
# ATTUNE_FILES_URL=
# ATTUNE_MODAL_KEY=

# Optional: secret for signing session cookies. If unset, it is derived from CREATOR_NAME and
# ATTUNE_MODAL_KEY, so changing either signs everyone out (random in mock mode, where there is no key).
# AUTH_SECRET=
