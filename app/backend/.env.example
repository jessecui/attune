# Name the access prompt asks for (required). Matched ignoring case and spaces.
CREATOR_NAME=

# The GPU service on Modal (not needed with ATTUNE_MOCK=1). `modal deploy modal_live.py` prints the two
# addresses. scripts/app.sh reads ATTUNE_MODAL_KEY from .live_key; on a host, set it here.
# ATTUNE_MODAL_URL=
# ATTUNE_FILES_URL=
# ATTUNE_MODAL_KEY=
# A Modal proxy token, so Modal refuses anyone else before a container starts:
#   modal workspace proxy-tokens create --name attune
# ATTUNE_MODAL_PROXY_ID=
# ATTUNE_MODAL_PROXY_SECRET=

# Optional: secret for signing session cookies. If unset, it is derived from CREATOR_NAME and
# ATTUNE_MODAL_KEY, so changing either signs everyone out (random in mock mode, where there is no key).
# AUTH_SECRET=
